# Copy this file to .env.local and fill in your credentials

# Supabase - https://supabase.com/dashboard → Your Project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Admin login (default: dhruv / dbphotography)
ADMIN_USER=dhruv
ADMIN_PASSWORD=dbphotography

# For production: set a strong random secret for session signing
# ADMIN_SESSION_SECRET=your-random-secret-at-least-32-chars
